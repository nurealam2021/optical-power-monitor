[Unit]
Description=Optical Power Monitor Next.js frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opticalmon
Group=opticalmon
WorkingDirectory=/opt/optical-power-monitor/frontend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/optical-power-monitor/frontend/node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/optical-power-monitor/frontend/.next/cache
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
