# Application
APP_NAME=BAHON Optical Power Monitor
APP_VERSION=1.0.0
ENVIRONMENT=development
API_PREFIX=/api

# Development database (easy local setup)
DATABASE_URL=sqlite:///./bahon_optical.db

# REQUIRED: use a unique random value in production.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-key-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Router access
ROUTER_SSH_TIMEOUT=20

# Browser/API origins. Comma-separated; no wildcard in production.
FRONTEND_URL=http://localhost:3000
HOST_FRONTEND_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Used by TrustedHostMiddleware in production. Do not use * in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Production DATABASE_URL example (replace user/password/db name):
# DATABASE_URL=postgresql+psycopg://optical_power_monitor:URL_ENCODED_PASSWORD@127.0.0.1:5432/optical_power_monitor
